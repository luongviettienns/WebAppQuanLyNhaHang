// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CASHIER
  KITCHEN
  ADMIN
}

enum EmployeeStatus {
  WORKING
  RESIGNED
}

enum EmployeeGender {
  MALE
  FEMALE
  OTHER
}

enum EmployeePayBasis {
  MONTHLY
  HOURLY
  PER_SHIFT
}

enum OrderType {
  DINE_IN
  TAKE_AWAY
  DELIVERY
}

enum DeliveryPartnerType {
  INDIVIDUAL
  COMPANY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  NEED_CLEANING
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
}

enum PaymentStatus {
  UNPAID
  WAITING_CONFIRMATION
  PAID
  VOIDED
}

enum OrderPaymentTransactionStatus {
  PENDING
  SUCCESS
  REJECTED
}

enum MenuType {
  FOOD
  DRINK
  SERVICE
  OTHER
}

enum MenuItemType {
  REGULAR
  TOPPING
  COMBO
  SERVICE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OrderReturnStatus {
  COMPLETED
  CANCELLED
}

enum PriceListType {
  GENERAL
  CUSTOM
}

enum PriceListScopeType {
  GLOBAL
  BRANCH
  CHANNEL
  CUSTOMER_GROUP
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum CustomerGender {
  MALE
  FEMALE
  OTHER
}

enum ReservationStatus {
  PENDING_DEPOSIT
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DepositStatus {
  UNPAID
  WAITING_CONFIRMATION
  PAID
  REFUND_PENDING
  REFUNDED
  FORFEITED
  APPLIED_TO_BILL
}

enum ReservationDepositTransactionType {
  DEPOSIT
  REFUND
  PARTIAL_REFUND
  FORFEIT
  APPLY_TO_BILL
}

enum ReservationDepositTransactionStatus {
  PENDING
  SUCCESS
  REJECTED
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  role         Role     @default(CASHIER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdOrders Order[]    @relation("CreatedOrders")
  voidedOrders  Order[]    @relation("VoidedOrders")
  auditLogs     AuditLog[] @relation("AuditLogs")
  confirmedOrderPaymentTransactions OrderPaymentTransaction[] @relation("OrderPaymentConfirmer")
  employeeProfile Employee?
  createdEmployeeCompensations EmployeeCompensation[] @relation("EmployeeCompensationCreator")
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
}

model JobTitle {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
}

model Employee {
  id                Int             @id @default(autoincrement())
  code              String          @unique @db.VarChar(32)
  attendanceCode    String          @unique @db.VarChar(32)
  name              String          @db.VarChar(160)
  phone             String          @db.VarChar(30)
  status            EmployeeStatus  @default(WORKING)
  userId            Int?            @unique
  avatarUrl         String?         @db.VarChar(500)
  departmentId      Int?
  jobTitleId        Int?
  startDate         DateTime?       @db.Date
  endDate           DateTime?       @db.Date
  note              String?         @db.VarChar(500)
  nationalId        String?         @unique @db.VarChar(32)
  birthDate         DateTime?       @db.Date
  gender            EmployeeGender?
  address           String?         @db.VarChar(255)
  province          String?         @db.VarChar(120)
  ward              String?         @db.VarChar(120)
  email             String?         @db.VarChar(160)
  facebook          String?         @db.VarChar(255)
  bankName          String?         @db.VarChar(120)
  bankAccountNumber String?         @db.VarChar(80)
  bankAccountName   String?         @db.VarChar(120)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user          User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  department    Department?            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobTitle      JobTitle?              @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  compensations EmployeeCompensation[]

  @@index([status, createdAt])
  @@index([name])
  @@index([departmentId, status])
  @@index([jobTitleId, status])
}

model EmployeeCompensation {
  id              Int              @id @default(autoincrement())
  employeeId      Int
  payBasis        EmployeePayBasis
  baseRate        Int
  effectiveFrom   DateTime         @db.Date
  note            String?          @db.VarChar(500)
  createdByUserId Int?
  createdAt       DateTime         @default(now())

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("EmployeeCompensationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
}

model CustomerGroup {
  id          Int        @id @default(autoincrement())
  code        String     @unique @db.VarChar(40)
  name        String     @unique @db.VarChar(120)
  description String?    @db.VarChar(500)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  customers   Customer[]
}

model Customer {
  id          Int             @id @default(autoincrement())
  code        String          @unique @db.VarChar(40)
  name        String          @db.VarChar(160)
  phone       String?         @unique @db.VarChar(30)
  email       String?         @db.VarChar(160)
  type        CustomerType    @default(INDIVIDUAL)
  gender      CustomerGender?
  birthDate   DateTime?       @db.Date
  province    String?         @db.VarChar(120)
  address     String?         @db.VarChar(255)
  groupId     Int?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  group        CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  orders       Order[]
  reservations Reservation[]

  @@index([groupId, isActive])
  @@index([name])
}

model ReservationPolicy {
  id                        Int      @id @default(autoincrement())
  name                      String   @unique @db.VarChar(120)
  depositAmount             Int      @default(300000)
  freeCancelBeforeMinutes   Int      @default(120)
  lateCancelRefundPercent   Int      @default(0)
  noShowRefundPercent       Int      @default(0)
  gracePeriodMinutes        Int      @default(30)
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  reservations              Reservation[]

  @@index([isActive])
}

model Reservation {
  id                              Int               @id @default(autoincrement())
  code                            String            @unique @db.VarChar(40)
  accessToken                     String            @unique @db.VarChar(96)
  customerId                      Int
  tableId                         Int?
  policyId                        Int?
  scheduledAt                     DateTime
  partySize                       Int
  contactName                     String            @db.VarChar(160)
  contactPhone                    String            @db.VarChar(30)
  note                            String?           @db.VarChar(1000)
  status                          ReservationStatus @default(PENDING_DEPOSIT)
  depositStatus                   DepositStatus     @default(UNPAID)
  depositAmount                   Int               @default(0)
  freeCancelBeforeMinutesSnapshot Int               @default(120)
  lateCancelRefundPercentSnapshot Int               @default(0)
  noShowRefundPercentSnapshot     Int               @default(0)
  gracePeriodMinutesSnapshot      Int               @default(30)
  paymentDeclaredAt               DateTime?
  checkedInAt                     DateTime?
  checkedInByUserId               Int?
  cancelledAt                     DateTime?
  cancelReason                    String?           @db.VarChar(500)
  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime          @updatedAt

  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  table           DiningTable?       @relation(fields: [tableId], references: [id], onDelete: SetNull)
  policy          ReservationPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  transactions    ReservationDepositTransaction[]
  changes         ReservationChange[]
  orders          Order[]

  @@index([status, scheduledAt])
  @@index([tableId, scheduledAt])
  @@index([customerId, scheduledAt])
}

model ReservationDepositTransaction {
  id                Int                                @id @default(autoincrement())
  reservationId     Int
  orderId           Int?
  type              ReservationDepositTransactionType
  status            ReservationDepositTransactionStatus @default(PENDING)
  amount            Int
  paymentMethod     PaymentMethod?
  externalReference String?                            @unique @db.VarChar(120)
  reason            String?                            @db.VarChar(500)
  confirmedByUserId Int?
  confirmedAt       DateTime?
  createdAt         DateTime                           @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([reservationId, orderId])
  @@index([reservationId, createdAt])
}

model ReservationChange {
  id                 Int         @id @default(autoincrement())
  reservationId      Int
  oldScheduledAt     DateTime
  newScheduledAt     DateTime
  reason             String?     @db.VarChar(500)
  changedByUserId    Int?
  createdAt          DateTime    @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
}

model Category {
  id           Int        @id @default(autoincrement())
  name         String
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  menuItems    MenuItem[]
}

model PriceList {
  id              Int                 @id @default(autoincrement())
  code            String              @unique
  name            String
  type            PriceListType       @default(GENERAL)
  scopeType       PriceListScopeType  @default(GLOBAL)
  scopeKey        String?
  isDefault       Boolean             @default(false)
  isActive        Boolean             @default(true)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  createdByUserId Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  items PriceListItem[]
  orders Order[]

  @@index([scopeType, scopeKey])
  @@index([isDefault, isActive])
  @@index([effectiveFrom, effectiveTo])
}

model MenuItem {
  id            Int          @id @default(autoincrement())
  categoryId    Int
  sku           String       @unique
  name          String
  description   String?      @db.Text
  basePrice     Int // VND nguyen
  imageUrl      String?
  isAvailable   Boolean      @default(true)
  displayOrder  Int          @default(0)
  menuType      MenuType     @default(FOOD)
  itemType      MenuItemType @default(REGULAR)
  trackStock    Boolean      @default(false)
  stockQuantity Int          @default(0)
  position      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]
  priceListItems PriceListItem[]
  menuItemIngredients MenuItemIngredient[]
}

model PriceListItem {
  id          Int      @id @default(autoincrement())
  priceListId Int
  menuItemId  Int
  salePrice   Int
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([priceListId, menuItemId])
  @@index([menuItemId])
}

model ModifierGroup {
  id         Int      @id @default(autoincrement())
  menuItemId Int
  name       String
  isRequired Boolean  @default(false)
  minSelect  Int      @default(0)
  maxSelect  Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  menuItem MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  ModifierOption[]
}

model ModifierOption {
  id              Int      @id @default(autoincrement())
  modifierGroupId Int
  name            String
  priceDelta      Int      @default(0) // VND phu phi
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
}

model DiningTable {
  id             Int         @id @default(autoincrement())
  tableNumber    Int         @unique
  displayName    String?     @db.VarChar(100)
  areaId         Int?
  qrCodeToken    String      @unique
  status         TableStatus @default(AVAILABLE)
  capacity       Int         @default(4)
  displayOrder   Int         @default(0)
  note           String?     @db.VarChar(500)
  isActive       Boolean     @default(true)
  currentOrderId Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  orders       Order[]
  reservations Reservation[]
  area         TableArea? @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([areaId])
  @@index([isActive])
}

model TableArea {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(100)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tables       DiningTable[]

  @@index([isActive, displayOrder])
}

model Order {
  id            Int            @id @default(autoincrement())
  code          String         @unique // Ma don CRISPY-YYYYMMDD-XXXX
  orderType     OrderType      @default(DINE_IN)
  status        OrderStatus    @default(PENDING)
  tableId       Int?
  customerId    Int?
  reservationId Int?
  deliveryPartnerId Int?
  deliveryAddress   String? @db.VarChar(255)
  deliveryFee       Int     @default(0)
  deliveryFeePaid   Int     @default(0)
  priceListId   Int?
  buzzerNumber  Int?
  totalAmount    Int // Tong tien truoc thue (VND)
  discountAmount Int            @default(0) // Tien giam gia tu voucher (VND)
  vatAmount      Int // Tien thue VAT 8% (VND)
  finalAmount    Int // Tong thanh toan (VND)
  voucherId      Int?
  voucherCode    String?
  paymentMethod  PaymentMethod?
  paymentStatus PaymentStatus  @default(UNPAID)
  payLaterAuthorized Boolean @default(false)
  paidAt        DateTime?
  notes         String?

  // Audit fields
  createdByUserId Int?
  voidedByUserId  Int?
  voidReason      String?
  voidedAt        DateTime?

  // Lifecycle Timestamps
  preparingAt DateTime?
  readyAt     DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  // Idempotency & Fingerprint
  idempotencyKey   String?
  idempotencyScope String  @default("guest")
  requestHash      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  table         DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  deliveryPartner DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id], onDelete: Restrict)
  priceList     PriceList?   @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  createdByUser User?        @relation("CreatedOrders", fields: [createdByUserId], references: [id], onDelete: SetNull)
  voidedByUser  User?        @relation("VoidedOrders", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  voucher       Voucher?     @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  inventoryTransactions InventoryTransaction[]
  returns       OrderReturn[]
  paymentTransactions OrderPaymentTransaction[]

  @@index([voucherId])
  @@unique([idempotencyScope, idempotencyKey])
  @@index([deliveryPartnerId, status])
  @@index([customerId, createdAt])
  @@index([reservationId])
}

model OrderPaymentTransaction {
  id                Int                            @id @default(autoincrement())
  orderId           Int
  status            OrderPaymentTransactionStatus @default(PENDING)
  amount            Int
  paymentMethod     PaymentMethod                 @default(BANK_TRANSFER)
  externalReference String?                        @unique @db.VarChar(120)
  reason            String?                        @db.VarChar(500)
  confirmedByUserId Int?
  confirmedAt       DateTime?
  createdAt         DateTime                       @default(now())

  order           Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  confirmedByUser User?  @relation("OrderPaymentConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, status, createdAt])
}

model OrderItem {
  id                    Int      @id @default(autoincrement())
  orderId               Int
  menuItemId            Int
  quantity              Int      @default(1)
  unitPrice             Int // Don gia tai thoi diem dat (VND)
  subtotal              Int // quantity * (unitPrice + modifiers)
  selectedModifiersJson Json? // Snapshot cac options da chon
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  returnLines OrderReturnLine[]
}

model OrderReturn {
  id                Int              @id @default(autoincrement())
  returnCode        String           @unique
  orderId           Int
  status            OrderReturnStatus @default(COMPLETED)
  returnedAt        DateTime         @default(now())
  totalRefundDue    Int              @default(0)
  refundedAmount    Int              @default(0)
  refundMethod      PaymentMethod    @default(CASH)
  note              String?          @db.VarChar(1000)
  createdByUserId   Int?
  createdByName     String?          @db.VarChar(120)
  completedAt       DateTime?
  cancelledByUserId Int?
  cancelledAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lines OrderReturnLine[]
  inventoryTransactions InventoryTransaction[]

  @@index([status, returnedAt])
  @@index([orderId, returnedAt])
}

model OrderReturnLine {
  id            Int @id @default(autoincrement())
  orderReturnId Int
  orderItemId   Int
  menuItemId    Int
  menuItemSku   String
  menuItemName  String
  quantity      Int
  unitPrice     Int
  lineAmount    Int
  createdAt     DateTime @default(now())

  orderReturn OrderReturn @relation(fields: [orderReturnId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([orderReturnId, orderItemId])
  @@index([orderItemId])
  @@index([menuItemId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String   // MENU_ITEM_CREATED | MENU_ITEM_UPDATED | MENU_ITEM_AVAILABILITY_CHANGED | MENU_IMAGE_UPLOADED | ORDER_VOIDED
  targetType String   // MenuItem | Order
  targetId   Int?
  actorId    Int?
  actorName  String?  // Snapshot ten user tai thoi diem log
  metadata   Json?    // Chi tiet thay doi (ten cu, ten moi, gia cu, gia moi...)
  createdAt  DateTime @default(now())

  actor User? @relation("AuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

enum InventoryTransactionType {
  STOCK_IN
  PURCHASE_RETURN
  AUTO_DEDUCT
  KITCHEN_WASTE
  MANUAL_ADJUST
  VOID_RESTORE
  SALES_RETURN
}

enum InventoryCheckStatus {
  DRAFT
  BALANCED
  CANCELLED
}

enum InventoryWasteStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model Ingredient {
  id           Int      @id @default(autoincrement())
  sku          String   @unique // Ma nguyen lieu (VD: ING-CHICKEN-01)
  name         String   // Ten nguyen lieu
  unit         String   // Don vi: gram, ml, piece, can...
  currentStock Float    @default(0) // Ton kho thuc te
  minThreshold Float    @default(0) // Nguong canh bao do
  costPerUnit  Int      @default(0) // Gia von trung binh (VND / don vi tinh)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  menuItemIngredients   MenuItemIngredient[]
  inventoryTransactions InventoryTransaction[]
  inventoryCheckLines   InventoryCheckLine[]
  inventoryWasteLines   InventoryWasteLine[]
  purchaseReceiptLines  PurchaseReceiptLine[]
  purchaseReturnLines   PurchaseReturnLine[]

  @@index([sku])
  @@index([isActive])
}

model MenuItemIngredient {
  id               Int      @id @default(autoincrement())
  menuItemId       Int
  ingredientId     Int
  quantityRequired Float    // Dinh luong tieu hao cho 1 phan mon an

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([menuItemId, ingredientId])
  @@index([menuItemId])
  @@index([ingredientId])
}

model InventoryTransaction {
  id              Int                      @id @default(autoincrement())
  ingredientId    Int
  type            InventoryTransactionType
  quantity        Float                    // + khi nhap kho, - khi xuat/hao hut
  costAmount      Int                      @default(0) // Gia tri VND giao dich
  orderId         Int?                     // Don hang lien quan (khi auto-deduct)
  purchaseReceiptId Int?                   // Chung tu nhap; null cho ledger cu
  inventoryCheckId Int?                    // Chung tu kiem kho; null cho ledger khac
  inventoryWasteId Int?                    // Chung tu xuat huy; null cho ledger khac
  purchaseReturnId Int?
  orderReturnId Int?
  note            String?                  // Ghi chu
  createdByUserId Int?
  createdAt       DateTime                 @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseReceipt PurchaseReceipt? @relation(fields: [purchaseReceiptId], references: [id], onDelete: Restrict)
  inventoryCheck InventoryCheck? @relation(fields: [inventoryCheckId], references: [id], onDelete: Restrict)
  inventoryWaste InventoryWaste? @relation(fields: [inventoryWasteId], references: [id], onDelete: Restrict)
  purchaseReturn PurchaseReturn? @relation(fields: [purchaseReturnId], references: [id], onDelete: Restrict)
  orderReturn OrderReturn? @relation(fields: [orderReturnId], references: [id], onDelete: Restrict)

  @@index([ingredientId])
  @@index([type])
  @@index([createdAt])
  @@index([purchaseReceiptId])
  @@index([inventoryCheckId])
  @@index([inventoryWasteId])
  @@unique([purchaseReturnId, ingredientId])
  @@unique([orderReturnId, ingredientId])
  @@index([orderReturnId])
}

model InventoryCheck {
  id                  Int                  @id @default(autoincrement())
  checkCode           String               @unique
  status              InventoryCheckStatus @default(DRAFT)
  countedAt           DateTime             @default(now())
  balancedAt          DateTime?
  note                String?              @db.VarChar(1000)
  createdByUserId     Int?
  balancedByUserId    Int?
  cancelledByUserId   Int?
  cancelledAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  lines                 InventoryCheckLine[]
  inventoryTransactions InventoryTransaction[]

  @@index([status, countedAt])
  @@index([countedAt])
}

model InventoryCheckLine {
  id               Int      @id @default(autoincrement())
  inventoryCheckId Int
  ingredientId     Int
  ingredientSku    String
  ingredientName   String
  unit             String
  systemQuantity   Float
  actualQuantity   Float?
  varianceQuantity Float?
  costPerUnit      Int
  varianceValue    Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inventoryCheck InventoryCheck @relation(fields: [inventoryCheckId], references: [id], onDelete: Cascade)
  ingredient     Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([inventoryCheckId, ingredientId])
  @@index([ingredientId])
}

model InventoryWaste {
  id                    Int                  @id @default(autoincrement())
  wasteCode             String               @unique
  status                InventoryWasteStatus @default(DRAFT)
  wastedAt              DateTime             @default(now())
  completedAt           DateTime?
  note                  String?              @db.VarChar(1000)
  totalValue            Int                  @default(0)
  createdByUserId       Int?
  completedByUserId     Int?
  cancelledByUserId     Int?
  cancelledAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  lines                 InventoryWasteLine[]
  inventoryTransactions InventoryTransaction[]

  @@index([status, wastedAt])
  @@index([wastedAt])
}

model InventoryWasteLine {
  id               Int      @id @default(autoincrement())
  inventoryWasteId Int
  ingredientId     Int
  ingredientSku    String
  ingredientName   String
  unit             String
  systemQuantity   Float
  quantity         Float
  costPerUnit      Int
  lineValue        Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inventoryWaste InventoryWaste @relation(fields: [inventoryWasteId], references: [id], onDelete: Cascade)
  ingredient     Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([inventoryWasteId, ingredientId])
  @@index([ingredientId])
}

enum PurchaseReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

model Supplier {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  phone     String?
  email     String?
  address   String?  @db.VarChar(255)
  taxCode   String?
  note      String?  @db.VarChar(1000)
  identityNumber String? @db.VarChar(20)
  province       String? @db.VarChar(100)
  district       String? @db.VarChar(100)
  ward           String? @db.VarChar(100)
  companyName    String? @db.VarChar(200)
  groupId        Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseReceipts PurchaseReceipt[]
  purchaseReturns PurchaseReturn[]
  group SupplierGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([name])
  @@index([isActive])
  @@index([groupId])
}

model SupplierGroup {
  id        Int @id @default(autoincrement())
  name      String @unique @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  suppliers Supplier[]
}

model DeliveryPartner {
  id          Int                 @id @default(autoincrement())
  code        String              @unique
  name        String
  phone       String?
  email       String?
  partnerType DeliveryPartnerType @default(INDIVIDUAL)
  address     String?             @db.VarChar(255)
  province    String?             @db.VarChar(100)
  district    String?             @db.VarChar(100)
  ward        String?             @db.VarChar(100)
  note        String?             @db.VarChar(1000)
  groupId     Int?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  group       DeliveryPartnerGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  orders      Order[]

  @@index([name])
  @@index([isActive])
  @@index([groupId])
}

model DeliveryPartnerGroup {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  partners  DeliveryPartner[]
}

model PurchaseReceipt {
  id                Int                   @id @default(autoincrement())
  receiptCode       String                @unique
  supplierId        Int?
  receivedAt        DateTime
  invoiceNumber     String?
  invoiceDate       DateTime?
  status            PurchaseReceiptStatus @default(DRAFT)
  subtotalAmount    Int                   @default(0)
  discountAmount    Int                   @default(0)
  paidAmount        Int                   @default(0)
  note              String?               @db.VarChar(1000)
  createdByUserId   Int?
  postedByUserId    Int?
  postedAt          DateTime?
  cancelledByUserId Int?
  cancelledAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  supplier              Supplier?            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines                 PurchaseReceiptLine[]
  purchaseReturns       PurchaseReturn[]
  inventoryTransactions InventoryTransaction[]

  @@index([supplierId, receivedAt])
  @@index([status, receivedAt])
}

model PurchaseReceiptLine {
  id                Int      @id @default(autoincrement())
  purchaseReceiptId Int
  ingredientId      Int
  ingredientSku     String
  ingredientName    String
  unit              String
  quantity          Float
  unitCost          Int
  discountAmount    Int      @default(0)
  note              String?  @db.VarChar(1000)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  purchaseReceipt PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  ingredient      Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  purchaseReturnLines PurchaseReturnLine[]

  @@unique([purchaseReceiptId, ingredientId])
  @@index([ingredientId])
}

model Voucher {
  id            Int          @id @default(autoincrement())
  code          String       @unique
  title         String
  discountType  DiscountType
  discountValue Int          // Ti le % (1-100) hoac so tien VND
  minOrderValue Int          @default(0) // Don hang toi thieu (VND)
  maxDiscount   Int?         // Giam toi da doi voi % (VND)
  usageLimit    Int          @default(100)
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orders        Order[]

  @@index([code, isActive])
}

enum PurchaseReturnStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model PurchaseReturn {
  id                  Int @id @default(autoincrement())
  returnCode          String @unique
  supplierId          Int?
  sourceReceiptId     Int?
  returnedAt          DateTime @default(now())
  status              PurchaseReturnStatus @default(DRAFT)
  version             Int @default(1)
  subtotalAmount      Int @default(0)
  discountAmount      Int @default(0)
  vatAmount           Int @default(0)
  refundAmount        Int @default(0)
  refundMethod        String @default("CASH") @db.VarChar(20)
  note                String? @db.VarChar(1000)
  createdByUserId     Int?
  createdByName       String? @db.VarChar(120)
  completedByUserId   Int?
  completedAt         DateTime?
  cancelledByUserId   Int?
  cancelledAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sourceReceipt PurchaseReceipt? @relation(fields: [sourceReceiptId], references: [id], onDelete: Restrict)
  lines PurchaseReturnLine[]
  inventoryTransactions InventoryTransaction[]

  @@index([status, returnedAt])
  @@index([supplierId, returnedAt])
  @@index([sourceReceiptId])
}

model PurchaseReturnLine {
  id                  Int @id @default(autoincrement())
  purchaseReturnId    Int
  ingredientId        Int
  sourceReceiptLineId Int?
  ingredientSku       String
  ingredientName      String
  unit                String
  quantity            Float
  purchaseUnitCost    Int
  returnUnitPrice     Int
  lineAmount          Int
  stockCostPerUnit    Int @default(0)
  stockCostAmount     Int @default(0)
  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  sourceReceiptLine PurchaseReceiptLine? @relation(fields: [sourceReceiptLineId], references: [id], onDelete: Restrict)

  @@unique([purchaseReturnId, ingredientId])
  @@index([ingredientId])
  @@index([sourceReceiptLineId])
}

