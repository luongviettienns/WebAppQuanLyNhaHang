{
  "info": {
    "name": "Crispy Bite Restaurant API",
    "description": "API Collection đầy đủ cho hệ thống quản lý nhà hàng Crispy Bite\n\n**Roles:**\n- CASHIER: Thu ngân\n- KITCHEN: Bếp/KDS\n- ADMIN: Quản trị viên\n\n**Authentication:**\nSử dụng JWT Bearer Token trong header Authorization",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "crispy-bite"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-refresh token nếu cần",
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-save token từ login response",
          "if (pm.response.code === 200 || pm.response.code === 201) {",
          "    const jsonData = pm.response.json();",
          "    if (jsonData.data && jsonData.data.token) {",
          "        pm.environment.set('token', jsonData.data.token);",
          "        console.log('✓ Token đã được lưu vào environment');",
          "    }",
          "    if (jsonData.data && jsonData.data.user) {",
          "        pm.environment.set('user_id', jsonData.data.user.id);",
          "        pm.environment.set('username', jsonData.data.user.username);",
          "        pm.environment.set('role', jsonData.data.user.role);",
          "        console.log('✓ User info đã được lưu');",
          "    }",
          "    if (jsonData.data && jsonData.data.order) {",
          "        pm.environment.set('order_id', jsonData.data.order.id);",
          "        console.log('✓ Order ID đã được lưu:', jsonData.data.order.id);",
          "    }",
          "    if (jsonData.data && jsonData.data.id && pm.info.requestName.includes('Menu')) {",
          "        pm.environment.set('menu_item_id', jsonData.data.id);",
          "        console.log('✓ Menu Item ID đã được lưu:', jsonData.data.id);",
          "    }",
          "}"
        ]
      }
    }
  ],
