  "description": "He thong dat mon va quan ly nha hang fast food Crispy Bite (Full-Stack QSR)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
